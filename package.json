{
  "name": "pypi.pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sst dev",
    "dev:api": "wrangler dev --config wrangler.dev.toml --local --port 8787",
    "deploy": "sst deploy --stage prod",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "lint": "oxlint",
    "db:seed:local": "bun scripts/seed-local.ts",
    "db:seed:snapshot": "bun scripts/seed-snapshot.ts",
    "db:seed:bigquery": "bun scripts/seed-bigquery.ts",
    "db:migrate": "bun src/migrate.ts",
    "db:generate": "drizzle-kit generate --dialect=postgresql --schema=src/schema.ts --out=./drizzle"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@pulumi/cloudflare": "^6.18.0",
    "@pulumi/command": "^1.2.1",
    "cfw-bq": "^0.0.3",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "sst": "^4.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@google-cloud/bigquery": "^9.0.1",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.3",
    "@types/pg-copy-streams": "^1.2.5",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  }
}
